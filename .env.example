# Optional: `npm run dev` needs no .env (ADR 0024). Copy to .env only to
# change something. Never commit a filled-in copy.

NODE_ENV=development
PORT=3000
# Where members' browsers reach the app; links in email point here. In
# development that is Vite, which proxies /auth and /api to the server.
PUBLIC_URL=http://localhost:5173

# Unset: a local PGlite database in LOCAL_DATA_DIR/pglite. Set it to use a
# real Postgres, such as the one `npm run db:up` starts. Production must set it.
#DATABASE_URL=postgres://rebel:rebel@localhost:5432/rebel_match
#LOCAL_DATA_DIR=.data
# Unset on a local PGlite run: generated once into LOCAL_DATA_DIR. Anywhere
# else it is required, 32+ characters.
#SESSION_SECRET=change-me-to-at-least-32-characters-long
# Signed-in members stay signed in this long unless they log out (R-AUTH-7).
#SESSION_TTL_DAYS=30

# Messages are always recorded in the outbound log (R-MSG-1). This decides only
# whether they leave the machine: 'none' in development, 'smtp' in production.
MAIL_DELIVERY=none

# Where the Feedback link sends members' mail (R-FB-1). Production must set a
# real inbox; the default reaches nobody.
#FEEDBACK_TO=feedback@rebel-match.invalid
MAIL_FROM=hello@rebel-match.invalid

# Production only, and required there (R-DEV-5). MAIL_DELIVERY=smtp needs SMTP_HOST.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=

# dev seeds the prototype fixtures; prod seeds the real whitelist (R-SEED-*).
SEED_PROFILE=dev
# prod profile only: comma-separated addresses seeded as admins (R-SEED-9).
#SEED_ADMINS=

CONSENT_VERSION=2026-11-01

# The log holds email addresses, so entries are purged after this many days.
OUTBOX_RETENTION_DAYS=30
# How often the server deletes entries past that window.
#OUTBOX_PURGE_INTERVAL_HOURS=1

# EU-residency project. The host must stay an EU endpoint (ADR 0005).
#MIXPANEL_TOKEN=
MIXPANEL_API_HOST=api-eu.mixpanel.com

# Abuse limits on sign-in (R-NFR-8, ADR 0029); the defaults suit the summit.
#LINK_EMAILS_BEFORE_CHECK=3
#LINK_EMAILS_CEILING=10
#LINK_EMAIL_WINDOW_MINUTES=15
#AUTH_REQUESTS_PER_IP=1000
#IP_WINDOW_MINUTES=15
#APPLICANTS_BEFORE_CHECK=30
#APPLICANTS_CEILING=300
#APPLICANT_WINDOW_MINUTES=60
#HUMAN_CHECK_COST=1000
#HUMAN_CHECK_MINUTES=5
# Proxy hops whose X-Forwarded-For is believed: 0 locally, 1 on Cloud Run.
#TRUST_PROXY=0

# How often each server re-reads the values hosts changed in the app (ADR 0031).
#SETTINGS_REFRESH_SECONDS=60

# A deleted account is hidden at once and erased after this many days (ADR 0032).
#ERASURE_GRACE_DAYS=30
# How often the server erases the deleted accounts that are due.
#ERASURE_SWEEP_INTERVAL_HOURS=1
# How often expired sessions and sign-in tokens are deleted (ADR 0034).
#TOKEN_PURGE_INTERVAL_HOURS=1

# Scheduled work runs on the server's timers, or on a tick from Cloud Scheduler
# with an OIDC token from TICK_INVOKER for TICK_AUDIENCE (ADR 0048).
#SCHEDULED_WORK=timers
#TICK_INVOKER=scheduler-tick@<project>.iam.gserviceaccount.com
#TICK_AUDIENCE=https://<service>-<project number>.europe-west6.run.app
