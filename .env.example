# Copy to .env for local development. Never commit a filled-in copy.

NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000

DATABASE_URL=mysql://rebel:rebel@localhost:3306/rebel_match
SESSION_SECRET=change-me-to-at-least-32-characters-long

# Development sends nothing: messages land in the admin outbox (R-DEV-1).
MAIL_TRANSPORT=outbox
MAIL_FROM=hello@rebel-match.invalid

# Production only. MAIL_TRANSPORT=smtp requires SMTP_HOST.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=

# dev seeds the prototype fixtures; prod seeds the real whitelist (R-SEED-*).
SEED_PROFILE=dev

CONSENT_VERSION=2026-11-01

# EU-residency project. The host must stay an EU endpoint (ADR 0005).
#MIXPANEL_TOKEN=
MIXPANEL_API_HOST=api-eu.mixpanel.com
