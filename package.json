{
  "name": "rebel-match",
  "version": "0.1.0",
  "private": true,
  "description": "Peer matching for the Corporate Rebels network",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.4.0",
    "@types/node": "^24.9.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.9.0",
    "eslint-plugin-import-x": "^4.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.9",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.1.0",
    "vitest": "^5.0.3",
    "@eslint/js": "^9.39.0"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --write"
    ]
  }
}
