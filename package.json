{
  "name": "rebel-match",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Peer matching for the Corporate Rebels network",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"tsx watch --env-file-if-exists=.env src/server.ts\" \"vite\"",
    "predev": "sh scripts/dev-prepare.sh",
    "dev:login": "tsx --env-file-if-exists=.env src/dev-login.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && vue-tsc -p client/tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "review": "tsx scripts/review/run.ts",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:reset": "tsx --env-file-if-exists=.env scripts/db-reset.ts && npm run migrate",
    "prepare": "husky"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "altcha-lib": "^2.5.0",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.4.0",
    "@eslint/js": "^9.39.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "altcha": "^3.2.4",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-vue": "^10.11.1",
    "husky": "^9.1.4",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.3.3",
    "supertest": "^7.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.1.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.12"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "concurrently": {
      "shell-quote": "^1.11.0"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    }
  }
}
